!.vscode/extensions.json
.idea/

# Python
**/__pycache__/
**/*.py[cod]
**/*.pyd
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/.coverage
**/.coverage.*
**/.venv/
**/venv/
**/env/
**/ENV/
**/*.egg-info/

# Node/web
**/node_modules/
**/dist/
**/dist-ssr/
**/build/
**/.next/
**/.turbo/
**/.pnpm-store/
**/.npm/
**/.yarn/
**/coverage/

# Environment & secrets
**/.env
**/.env.*
**/serviceAccountKey.json
**/*.pem
**/*.key

# ML/data artifacts
**/*.nii
**/*.nii.gz
**/*.h5
**/*.hdf5
**/*.onnx
**/*.pt
**/*.pth
**/*.joblib
**/*.pkl
**/*.pickle

